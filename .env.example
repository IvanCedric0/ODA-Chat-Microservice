# -----------------------------------------------------------------------------
# Micro-service Chat - Configuration Environnement
# -----------------------------------------------------------------------------

# Configuration Serveur HTTP (Fastify)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Base de Données PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oda_chat?schema=public"

# Authentification & Signature JWT (Délégation Identity — RS256 + JWKS)
# Obligatoire en production ; en dev local sans identity, laisser vide pour activer le fallback HS256 (JWT_SECRET)
JWT_JWKS_URL="http://identity:4001/api/identity/.well-known/jwks.json"
JWT_ISSUER="http://localhost/api/identity"
JWT_AUDIENCE="odc-campus"
# Fallback HS256 hors production uniquement (si JWT_JWKS_URL est vide/absent)
JWT_SECRET="votre_cle_secrete_jwt_dev_uniquement"
SERVICE_API_KEY="votre_cle_service"

# Sécurité & Cloisonnement (CORS / CSP)
ALLOWED_ORIGINS="http://localhost:5173,https://*.domain.local"
EMBED_BASE_URL="http://localhost:3000/embed"
