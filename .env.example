# -----------------------------------------------------------------------------
# Micro-service Chat - Configuration Environnement
# -----------------------------------------------------------------------------

# Configuration Serveur HTTP (Fastify)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Base de Données PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://chat_user:chat_db@localhost:5433/chat_user?schema=public"

# Authentification & Signature JWT (Délégation Identity)
JWT_SECRET="votre_cle_secrete_jwt_partagee_avec_identity"

# Sécurité & Cloisonnement (CORS / CSP)
ALLOWED_ORIGINS="http://localhost:5173,https://*.domain.local"
EMBED_BASE_URL="http://localhost:3000/embed"
